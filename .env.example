# Copy to .env (never commit .env). Used ONLY by the Node scripts in /scripts.
# The browser app does not read this file — its public config lives in public/js/config.js.

# Your Firebase project id (Firebase console -> Project settings).
FIREBASE_PROJECT_ID=your-project-id

# Path to a service-account JSON kept OUTSIDE this repo, used only by seed-firestore.js.
# Alternative: leave unset and run `gcloud auth application-default login` instead.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/secrets/cafeq-admin.json

# Optional: seed the local Firestore emulator instead of the real project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public HTTPS base URL of the deployed site, used by make-qr.js to build QR links.
CAFEQ_BASE_URL=https://your-project-id.web.app
